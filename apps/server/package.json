{
  "name": "@jonlix/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "esbuild src/index.ts src/sheets/init.ts --bundle --platform=node --format=esm --outdir=dist --outbase=src --external:better-sqlite3 --external:googleapis --external:fastify --external:@fastify/helmet --external:grammy --external:node-cron --external:dotenv --external:zod --external:date-fns --external:date-fns-tz",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "sheets:init": "tsx src/sheets/init.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.1",
    "@jonlix/shared": "workspace:*",
    "better-sqlite3": "^11.8.1",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "googleapis": "^144.0.0",
    "grammy": "^1.35.0",
    "node-cron": "^3.0.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "@types/node-cron": "^3.0.11",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
